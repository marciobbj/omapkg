pkgname=omapkg
pkgver=0.1.0
pkgrel=1
pkgdesc='Manage installed apps, disk usage, and updates across Omarchy, Pacman, AUR, and Flatpak'
url='https://github.com/marciobbj/omapkg'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'xdg-desktop-portal'
  'expac'
  'pacman-contrib'
  'polkit'
)
optdepends=(
  'yay: AUR package updates and management'
  'flatpak: Flatpak application management'
)
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  OMAPKG_BUILD_DIR="$srcdir/build" ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/build/omapkg" "$pkgdir/usr/bin/omapkg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omapkg.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omapkg.svg"
  install -Dm644 "$startdir/omapkg.desktop" "$pkgdir/usr/share/applications/omapkg.desktop"
  install -Dm644 manifest.json "$pkgdir/usr/share/$pkgname/manifest.json"
  install -Dm644 bar-plugin/BarWidget.qml "$pkgdir/usr/share/$pkgname/bar-plugin/BarWidget.qml"
  install -Dm755 bar-plugin/omapkg-bar-helper "$pkgdir/usr/share/$pkgname/bar-plugin/omapkg-bar-helper"
}
